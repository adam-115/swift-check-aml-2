<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Référentiel PEP : pays, catégories, fonctions, et couverture des fonctions par les sources -->
    <changeSet id="002-create-pep-reference-tables" author="adam">

        <!-- Pays couverts : UE + Suisse. retention_months = durée minimale de vigilance après la fin des fonctions -->
        <createTable tableName="country">
            <column name="iso" type="VARCHAR(2)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="eu_member" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="legal_basis" type="VARCHAR(500)"/>
            <column name="retention_months" type="INT" defaultValueNumeric="12">
                <constraints nullable="false"/>
            </column>
            <column name="official_list_reference" type="VARCHAR(255)"/>
            <column name="official_list_date" type="DATE"/>
            <column name="official_list_url" type="VARCHAR(1024)"/>
        </createTable>

        <!-- Catégorie de fonctions PEP d'un pays (ex. LU-b « Parlementaires et Conseil d'État ») -->
        <createTable tableName="pep_category">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="country_iso" type="VARCHAR(2)">
                <constraints nullable="false" foreignKeyName="fk_pep_category_country" references="country(iso)"/>
            </column>
            <column name="code" type="VARCHAR(20)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_pep_category_code"/>
            </column>
            <column name="label" type="VARCHAR(500)">
                <constraints nullable="false"/>
            </column>
            <!-- OFFICIAL, AMLR, RISK_BASED, EU ou RCA (voir PepCategoryKind) -->
            <column name="kind" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <!-- 1 = risque le plus élevé, 4 = le plus faible -->
            <column name="risk_class" type="INT" defaultValueNumeric="2">
                <constraints nullable="false"/>
            </column>
            <column name="sort_order" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="legal_reference" type="VARCHAR(500)"/>
        </createTable>

        <!-- Fonction précise d'une catégorie (ex. « Député », Chambre des Députés, 60 titulaires) -->
        <createTable tableName="pep_function">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="category_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_pep_function_category" references="pep_category(id)"/>
            </column>
            <column name="label" type="VARCHAR(500)">
                <constraints nullable="false"/>
            </column>
            <column name="institution" type="VARCHAR(255)"/>
            <column name="expected_holders" type="INT"/>
        </createTable>

        <!-- Fonctions PEP couvertes par une source, et à quel point -->
        <createTable tableName="parser_coverage">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="data_source_config_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_parser_coverage_source" references="data_source_config(id)"/>
            </column>
            <column name="pep_function_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_parser_coverage_function" references="pep_function(id)"/>
            </column>
            <!-- COMPLETE : tous les titulaires ; PARTIAL : une partie seulement -->
            <column name="completeness" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="includes_former" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="parser_coverage" columnNames="data_source_config_id, pep_function_id"
                             constraintName="uk_parser_coverage"/>
    </changeSet>

    <!-- Une source dit si elle publie des sanctions ou des PEP, son type T1 à T7 et son pays -->
    <changeSet id="002-add-pep-columns-to-data-source-config" author="adam">
        <addColumn tableName="data_source_config">
            <!-- SANCTION ou PEP -->
            <column name="list_type" type="VARCHAR(20)"/>
            <!-- OPEN_DATA_FILE, API, SPARQL, OFFICIAL_GAZETTE, WEB_PAGE, PDF_DOCUMENT, DECLARATION_REGISTER -->
            <column name="parser_type" type="VARCHAR(30)"/>
            <column name="country_iso" type="VARCHAR(2)">
                <constraints foreignKeyName="fk_data_source_config_country" references="country(iso)"/>
            </column>
            <column name="retention_months" type="INT"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
