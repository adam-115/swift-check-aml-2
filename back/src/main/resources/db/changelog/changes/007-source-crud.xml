<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Gestion des sources depuis l'interface :
        - customized : la source a été modifiée dans l'interface, le catalogue ne l'écrase plus au démarrage ;
        - deleted_at : source supprimée (l'historique des exécutions est gardé) ; le catalogue ne la recrée pas.
    -->
    <changeSet id="007-source-crud" author="adam">
        <renameColumn tableName="data_source_config" oldColumnName="source_path_customized" newColumnName="customized"
                      columnDataType="BOOLEAN"/>
        <addColumn tableName="data_source_config">
            <column name="deleted_at" type="DATETIME"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
