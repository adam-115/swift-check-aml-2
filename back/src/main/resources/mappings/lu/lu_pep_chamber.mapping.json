{
  "name": "lu_pep_chamber",
  "description": "Députés en fonction : une ligne du CSV donne la Person, la Position commune et l'Occupancy",
  "applyAllRules": true,
  "derivedFields": [
    { "name": "_personKey", "template": "{_dataset}:{pph_nom}:{pph_prenom}:{pph_date_naissance}" },
    { "name": "_fullName", "template": "{pph_prenom} {pph_nom}" },
    { "name": "_positionKey", "template": "{_dataset}:deputy" },
    { "name": "_positionName", "template": "Député à la Chambre des Députés du Luxembourg" },
    { "name": "_occupancyKey", "template": "{_personKey}:deputy:{date_debut_depute}" },
    { "name": "_country", "template": "lu" },
    { "name": "_personTopics", "template": "role.pep" },
    { "name": "_positionTopics", "template": "gov.national;gov.legislative", "split": ";" },
    { "name": "_status", "template": "current" }
  ],
  "recordFilters": [
    { "path": "pph_nom", "operator": "NOT_EMPTY" }
  ],
  "rules": [
    {
      "targetNodeName": "row",
      "ftmSchema": "Person",
      "idJsonPaths": ["$._personKey"],
      "propertiesMapping": {
        "name": "$._fullName",
        "firstName": "$.pph_prenom",
        "lastName": "$.pph_nom",
        "birthDate": "$.pph_date_naissance",
        "gender": "$.per_titre",
        "country": "$._country",
        "political": "$.rattachement_abrv",
        "topics": "$._personTopics",
        "sourceUrl": "$._sourceUrl"
      },
      "propertyTypes": { "birthDate": "date", "gender": "gender", "country": "country" }
    },
    {
      "targetNodeName": "row",
      "ftmSchema": "Position",
      "idJsonPaths": ["$._positionKey"],
      "propertiesMapping": {
        "name": "$._positionName",
        "country": "$._country",
        "topics": "$._positionTopics"
      },
      "propertyTypes": { "country": "country" }
    },
    {
      "targetNodeName": "row",
      "ftmSchema": "Occupancy",
      "idJsonPaths": ["$._occupancyKey"],
      "propertiesMapping": {
        "holder": "$._personKey",
        "post": "$._positionKey",
        "startDate": "$.date_debut_depute",
        "status": "$._status",
        "politicalGroup": "$.rattachement_abrv"
      },
      "propertyTypes": { "holder": "entity", "post": "entity", "startDate": "date" }
    }
  ]
}
