{
  "name": "lu_pep_council_of_state",
  "description": "Une ligne par conseiller : « <b>Nom Prénom</b>, profession, né le ..., nommé le ..., démissionnaire à partir du ... »",
  "applyAllRules": true,
  "derivedFields": [
    { "name": "_cleanName", "from": "name", "regex": "[,;:\\s]+$", "replacement": "" },
    { "name": "_lastName", "from": "_cleanName", "regex": "^((?:(?:Du|Von|Van|De la|De)\\s+)?\\S+)\\s+(.+)$", "group": 1 },
    { "name": "_firstName", "from": "_cleanName", "regex": "^((?:(?:Du|Von|Van|De la|De)\\s+)?\\S+)\\s+(.+)$", "group": 2 },
    { "name": "_fullName", "template": "{_firstName} {_lastName}", "requireAll": true },
    { "name": "_displayName", "from": "_fullName||_cleanName" },
    { "name": "_personSlug", "from": "_cleanName", "slug": true },
    { "name": "_personKey", "template": "{_dataset}:{_personSlug}" },

    { "name": "_birth", "from": "body", "regex": "(?i)n[ée]e?\\s+le\\s+(\\d{1,2}[./-]\\d{1,2}[./-]\\d{4})" },
    { "name": "_nominated", "from": "body", "regex": "(?i)nomm[ée]e?\\s+(?:le\\s+)?(\\d{1,2}[./-]\\d{1,2}[./-]\\d{4})" },
    { "name": "_sworn", "from": "body", "regex": "(?i)asserment[ée]e?\\s+(?:le\\s+)?(\\d{1,2}[./-]\\d{1,2}[./-]\\d{4})" },
    { "name": "_start", "from": "_nominated||_sworn" },
    { "name": "_resigned", "from": "body", "regex": "(?i)(?:d[ée]missionn[ée]e?(?:\\s+sur\\s+sa\\s+demande)?|d[ée]missionnaire)\\s+(?:[àa]\\s+partir\\s+du\\s+|le\\s+)?(\\d{1,2}[./-]\\d{1,2}[./-]\\d{4})" },
    { "name": "_replaced", "from": "body", "regex": "(?i)remplac[ée]e?\\s+par\\s+.*?le\\s+(\\d{1,2}[./-]\\d{1,2}[./-]\\d{4})" },
    { "name": "_interval", "from": "body", "regex": "(?i)-\\s*(\\d{1,2}[./-]\\d{1,2}[./-]\\d{4})\\." },
    { "name": "_end", "from": "_resigned||_replaced||_interval" },

    { "name": "_recentYear", "from": "_start", "regex": "(201[2-9]|20[2-9]\\d)$" },
    { "name": "_endedFlag", "from": "_end", "regex": ".+", "replacement": "ended" },
    { "name": "_currentFlag", "template": "current-{_recentYear}", "requireAll": true },
    { "name": "_statusRaw", "from": "_endedFlag||_currentFlag" },
    { "name": "_status", "from": "_statusRaw", "regex": "^current-.*$", "replacement": "current", "defaultValue": "ended" },
    { "name": "_activeMarker", "template": "2999-{_recentYear}", "requireAll": true },
    { "name": "_activeDate", "from": "_activeMarker", "regex": "^(\\d{4})-.*$", "replacement": "$1" },
    { "name": "_filterDate", "from": "_end||_activeDate||_start" },

    { "name": "_role", "from": "body", "regex": "(?i)nomm[ée]e?\\s+(Vice-Pr[ée]sident|Pr[ée]sident)e?\\s+le" },
    { "name": "_rolePosition", "template": "{_role} du Conseil d'État", "requireAll": true },
    { "name": "_positionName", "from": "_rolePosition", "defaultValue": "Membre du Conseil d'État" },
    { "name": "_positionSlug", "from": "_positionName", "slug": true },
    { "name": "_positionKey", "template": "{_dataset}:{_positionSlug}" },
    { "name": "_occupancyKey", "template": "{_personKey}:{_positionSlug}:{_start}" },
    { "name": "_country", "template": "lu" },
    { "name": "_personTopics", "template": "role.pep" },
    { "name": "_positionTopics", "template": "gov.national;gov.legislative", "split": ";" }
  ],
  "recordFilters": [
    { "path": "_cleanName", "operator": "NOT_EMPTY" },
    { "path": "_cleanName", "operator": "NOT_MATCHES", "value": "^S\\.A\\.R\\." },
    { "path": "_start", "operator": "NOT_EMPTY" },
    { "path": "_filterDate", "operator": "WITHIN_YEARS", "value": "5" }
  ],
  "rules": [
    {
      "ftmSchema": "Person",
      "idJsonPaths": ["$._personKey"],
      "propertiesMapping": {
        "name": "$._displayName",
        "firstName": "$._firstName",
        "lastName": "$._lastName",
        "birthDate": "$._birth",
        "country": "$._country",
        "topics": "$._personTopics",
        "sourceUrl": "$._sourceUrl"
      },
      "propertyTypes": { "birthDate": "date", "country": "country" }
    },
    {
      "ftmSchema": "Position",
      "idJsonPaths": ["$._positionKey"],
      "propertiesMapping": { "name": "$._positionName", "country": "$._country", "topics": "$._positionTopics" },
      "propertyTypes": { "country": "country" }
    },
    {
      "ftmSchema": "Occupancy",
      "idJsonPaths": ["$._occupancyKey"],
      "propertiesMapping": {
        "holder": "$._personKey",
        "post": "$._positionKey",
        "startDate": "$._start",
        "endDate": "$._end",
        "status": "$._status"
      },
      "propertyTypes": { "holder": "entity", "post": "entity", "startDate": "date", "endDate": "date" }
    }
  ]
}
