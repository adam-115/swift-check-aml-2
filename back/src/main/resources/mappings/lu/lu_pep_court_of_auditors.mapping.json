{
  "name": "lu_pep_court_of_auditors",
  "description": "Un titre « Prénom Nom » (lien vers la fiche) suivi de la fonction en italique",
  "applyAllRules": true,
  "derivedFields": [
    { "name": "_page", "from": "url", "regex": "/college/([^/.]+)\\.html" },
    { "name": "_personSlug", "from": "_page||name", "slug": true },
    { "name": "_personKey", "template": "{_dataset}:{_personSlug}" },
    { "name": "_firstName", "from": "name", "regex": "^(\\S+)\\s+(.+)$", "group": 1 },
    { "name": "_lastName", "from": "name", "regex": "^(\\S+)\\s+(.+)$", "group": 2 },
    { "name": "_roleDescription", "template": "{role} de la Cour des comptes", "requireAll": true },
    { "name": "_positionKey", "template": "{_dataset}:member" },
    { "name": "_positionName", "template": "Membre de la Cour des comptes" },
    { "name": "_occupancyKey", "template": "{_personKey}:member" },
    { "name": "_country", "template": "lu" },
    { "name": "_personTopics", "template": "role.pep" },
    { "name": "_positionTopics", "template": "gov.national", "split": ";" },
    { "name": "_status", "template": "current" }
  ],
  "recordFilters": [
    { "path": "name", "operator": "NOT_EMPTY" }
  ],
  "rules": [
    {
      "ftmSchema": "Person",
      "idJsonPaths": ["$._personKey"],
      "propertiesMapping": {
        "name": "$.name",
        "firstName": "$._firstName",
        "lastName": "$._lastName",
        "position": "$._roleDescription",
        "country": "$._country",
        "topics": "$._personTopics",
        "sourceUrl": "$.url"
      },
      "propertyTypes": { "country": "country" }
    },
    {
      "ftmSchema": "Position",
      "idJsonPaths": ["$._positionKey"],
      "propertiesMapping": { "name": "$._positionName", "country": "$._country", "topics": "$._positionTopics" },
      "propertyTypes": { "country": "country" }
    },
    {
      "ftmSchema": "Occupancy",
      "idJsonPaths": ["$._occupancyKey"],
      "propertiesMapping": {
        "holder": "$._personKey",
        "post": "$._positionKey",
        "status": "$._status",
        "description": "$._roleDescription"
      },
      "propertyTypes": { "holder": "entity", "post": "entity" }
    }
  ]
}
