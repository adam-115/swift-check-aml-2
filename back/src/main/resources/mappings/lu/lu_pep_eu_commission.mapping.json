{
  "name": "lu_pep_eu_commission",
  "description": "Page d'un commissaire : nom (og:title) et portefeuille (description), gardée seulement si elle le dit luxembourgeois",
  "applyAllRules": true,
  "derivedFields": [
    { "name": "_firstName", "from": "name", "regex": "^(\\S+)\\s+(.+)$", "group": 1 },
    { "name": "_lastName", "from": "name", "regex": "^(\\S+)\\s+(.+)$", "group": 2 },
    { "name": "_personSlug", "from": "name", "slug": true },
    { "name": "_personKey", "template": "{_dataset}:{_personSlug}" },
    { "name": "_portfolio", "from": "description", "regex": "(?i)charg[ée]e?\\s+(?:de\\s+|du\\s+|des\\s+)?(.+?)\\s+au sein" },
    { "name": "_president", "from": "description", "regex": "(?i)\\b(présidente?|president)\\b" },
    { "name": "_presidentPosition", "template": "Président de la Commission européenne ({_president})", "requireAll": true },
    { "name": "_positionName", "from": "_presidentPosition", "regex": "^.*$", "replacement": "Président de la Commission européenne", "defaultValue": "Membre luxembourgeois de la Commission européenne" },
    { "name": "_positionSlug", "from": "_positionName", "slug": true },
    { "name": "_positionKey", "template": "{_dataset}:{_positionSlug}" },
    { "name": "_occupancyKey", "template": "{_personKey}:{_positionSlug}:2024-12-01" },
    { "name": "_start", "template": "2024-12-01" },
    { "name": "_country", "template": "lu" },
    { "name": "_personTopics", "template": "role.pep" },
    { "name": "_positionTopics", "template": "gov.igo;gov.executive", "split": ";" },
    { "name": "_status", "template": "current" }
  ],
  "recordFilters": [
    { "path": "name", "operator": "NOT_EMPTY" },
    { "path": "description", "operator": "MATCHES", "value": "luxembourg" }
  ],
  "rules": [
    {
      "ftmSchema": "Person",
      "idJsonPaths": ["$._personKey"],
      "propertiesMapping": {
        "name": "$.name",
        "firstName": "$._firstName",
        "lastName": "$._lastName",
        "country": "$._country",
        "topics": "$._personTopics",
        "sourceUrl": "$._sourceUrl"
      },
      "propertyTypes": { "country": "country" }
    },
    {
      "ftmSchema": "Position",
      "idJsonPaths": ["$._positionKey"],
      "propertiesMapping": { "name": "$._positionName", "country": "$._country", "topics": "$._positionTopics" },
      "propertyTypes": { "country": "country" }
    },
    {
      "ftmSchema": "Occupancy",
      "idJsonPaths": ["$._occupancyKey"],
      "propertiesMapping": {
        "holder": "$._personKey",
        "post": "$._positionKey",
        "startDate": "$._start",
        "status": "$._status",
        "description": "$._portfolio"
      },
      "propertyTypes": { "holder": "entity", "post": "entity", "startDate": "date" }
    }
  ]
}
