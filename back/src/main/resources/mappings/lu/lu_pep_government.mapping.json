{
  "name": "lu_pep_government",
  "description": "Un lien vers la page d'un membre du gouvernement = un membre ; identifiant = nom de sa page (ex. luc-frieden)",
  "applyAllRules": true,
  "derivedFields": [
    { "name": "_page", "from": "href", "regex": "/gouvernement/([a-z0-9-]+)\\.html" },
    { "name": "_personKey", "template": "{_dataset}:{_page}" },
    { "name": "_lastName", "from": "displayName", "regex": "((?:\\b\\p{Lu}[\\p{Lu}'’-]+\\b\\s*)+)$" },
    { "name": "_firstName", "from": "displayName", "regex": "^(.*?)\\s+(?:\\p{Lu}[\\p{Lu}'’-]+\\b\\s*)+$" },
    { "name": "_profileUrl", "template": "https://gouvernement.lu/fr/gouvernement/{_page}.html" },
    { "name": "_positionKey", "template": "{_dataset}:member" },
    { "name": "_positionName", "template": "Membre du gouvernement du Luxembourg" },
    { "name": "_occupancyKey", "template": "{_personKey}:member" },
    { "name": "_country", "template": "lu" },
    { "name": "_personTopics", "template": "role.pep" },
    { "name": "_positionTopics", "template": "gov.national;gov.executive", "split": ";" },
    { "name": "_status", "template": "current" }
  ],
  "recordFilters": [
    { "path": "_page", "operator": "NOT_EMPTY" },
    { "path": "_page", "operator": "NOT_MATCHES", "value": "^anciens-membres" },
    { "path": "displayName", "operator": "MATCHES", "value": "\\p{Lu}{2,}" }
  ],
  "rules": [
    {
      "ftmSchema": "Person",
      "idJsonPaths": ["$._personKey"],
      "propertiesMapping": {
        "name": "$.displayName",
        "firstName": "$._firstName",
        "lastName": "$._lastName",
        "country": "$._country",
        "topics": "$._personTopics",
        "sourceUrl": "$._profileUrl"
      },
      "propertyTypes": { "country": "country" }
    },
    {
      "ftmSchema": "Position",
      "idJsonPaths": ["$._positionKey"],
      "propertiesMapping": { "name": "$._positionName", "country": "$._country", "topics": "$._positionTopics" },
      "propertyTypes": { "country": "country" }
    },
    {
      "ftmSchema": "Occupancy",
      "idJsonPaths": ["$._occupancyKey"],
      "propertiesMapping": { "holder": "$._personKey", "post": "$._positionKey", "status": "$._status" },
      "propertyTypes": { "holder": "entity", "post": "entity" }
    }
  ]
}
