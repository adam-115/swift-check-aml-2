{
  "name": "lu_pep_government_former",
  "description": "Une ligne de mandat (« Ministre des Finances, du 05.01.2022 au 16.11.2023 ») sous le nom « NOM Prénom »",
  "applyAllRules": true,
  "derivedFields": [
    { "name": "_lastName", "from": "header", "regex": "^((?:\\p{Lu}[\\p{Lu}'’-]+\\s*)+)\\s" },
    { "name": "_firstName", "from": "header", "regex": "^(?:\\p{Lu}[\\p{Lu}'’-]+\\s*)+\\s(.+)$" },
    { "name": "_fullName", "template": "{_firstName} {_lastName}" },
    { "name": "_personSlug", "from": "header", "slug": true },
    { "name": "_personKey", "template": "{_dataset}:{_personSlug}" },

    { "name": "_endedFunction", "from": "line", "regex": "^(.*?),?\\s*du\\s+(\\d{1,2}[.\\s][^,]*?\\d{4})\\s+au\\s+(\\d{1,2}[.\\s][^,]*?\\d{4})", "group": 1 },
    { "name": "_startEnded", "from": "line", "regex": "^(.*?),?\\s*du\\s+(\\d{1,2}[.\\s][^,]*?\\d{4})\\s+au\\s+(\\d{1,2}[.\\s][^,]*?\\d{4})", "group": 2 },
    { "name": "_end", "from": "line", "regex": "^(.*?),?\\s*du\\s+(\\d{1,2}[.\\s][^,]*?\\d{4})\\s+au\\s+(\\d{1,2}[.\\s][^,]*?\\d{4})", "group": 3 },
    { "name": "_currentFunction", "from": "line", "regex": "^(.*?)\\s+(?:depuis le|le)\\s+(\\d{1,2}\\.\\d{1,2}\\.\\d{4})$", "group": 1 },
    { "name": "_startCurrent", "from": "line", "regex": "^(.*?)\\s+(?:depuis le|le)\\s+(\\d{1,2}\\.\\d{1,2}\\.\\d{4})$", "group": 2 },
    { "name": "_rawFunction", "from": "_endedFunction||_currentFunction||line" },
    { "name": "_function", "from": "_rawFunction", "regex": "[,;\\s]+$", "replacement": "" },
    { "name": "_start", "from": "_startEnded||_startCurrent" },
    { "name": "_status", "from": "_currentFunction", "regex": ".+", "replacement": "current", "defaultValue": "ended" },

    { "name": "_functionSlug", "from": "_function", "slug": true },
    { "name": "_positionKey", "template": "{_dataset}:{_functionSlug}" },
    { "name": "_occupancyKey", "template": "{_personKey}:{_functionSlug}:{_start}:{_end}" },
    { "name": "_country", "template": "lu" },
    { "name": "_personTopics", "template": "role.pep" },
    { "name": "_positionTopics", "template": "gov.national;gov.executive", "split": ";" }
  ],
  "recordFilters": [
    { "path": "_lastName", "operator": "NOT_EMPTY" },
    { "path": "_function", "operator": "MATCHES", "value": "(ministre|secrétaire|secretaire|premier|vice)" },
    { "path": "_end", "operator": "WITHIN_YEARS", "value": "5" }
  ],
  "rules": [
    {
      "ftmSchema": "Person",
      "idJsonPaths": ["$._personKey"],
      "propertiesMapping": {
        "name": "$._fullName",
        "firstName": "$._firstName",
        "lastName": "$._lastName",
        "country": "$._country",
        "topics": "$._personTopics",
        "sourceUrl": "$._sourceUrl"
      },
      "propertyTypes": { "country": "country" }
    },
    {
      "ftmSchema": "Position",
      "idJsonPaths": ["$._positionKey"],
      "propertiesMapping": { "name": "$._function", "country": "$._country", "topics": "$._positionTopics" },
      "propertyTypes": { "country": "country" }
    },
    {
      "ftmSchema": "Occupancy",
      "idJsonPaths": ["$._occupancyKey"],
      "propertiesMapping": {
        "holder": "$._personKey",
        "post": "$._positionKey",
        "startDate": "$._start",
        "endDate": "$._end",
        "status": "$._status"
      },
      "propertyTypes": { "holder": "entity", "post": "entity", "startDate": "date", "endDate": "date" }
    }
  ]
}
