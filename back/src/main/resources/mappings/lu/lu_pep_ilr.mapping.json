{
  "name": "lu_pep_ilr",
  "description": "Direction d'une autorité de régulation : une fiche par dirigeant (nom et fonction)",
  "applyAllRules": true,
  "derivedFields": [
    { "name": "_fullName", "from": "name", "regex": "[\\s,]+$", "replacement": "" },
    { "name": "_firstName", "from": "_fullName", "regex": "^(\\S+)\\s+(.+)$", "group": 1 },
    { "name": "_lastName", "from": "_fullName", "regex": "^(\\S+)\\s+(.+)$", "group": 2 },
    { "name": "_personSlug", "from": "_fullName", "slug": true },
    { "name": "_personKey", "template": "{_dataset}:{_personSlug}" },
    { "name": "_roleDescription", "template": "{role} de l'Institut Luxembourgeois de Régulation", "requireAll": true },
    { "name": "_positionKey", "template": "{_dataset}:direction" },
    { "name": "_positionName", "template": "Membre de la direction de l'Institut Luxembourgeois de Régulation" },
    { "name": "_occupancyKey", "template": "{_personKey}:direction" },
    { "name": "_country", "template": "lu" },
    { "name": "_personTopics", "template": "role.pep" },
    { "name": "_positionTopics", "template": "gov.national;gov.regulatory", "split": ";" },
    { "name": "_status", "template": "current" }
  ],
  "recordFilters": [
    { "path": "_lastName", "operator": "NOT_EMPTY" },
    { "path": "role", "operator": "MATCHES", "value": "direct|président|membre" }
  ],
  "rules": [
    {
      "ftmSchema": "Person",
      "idJsonPaths": ["$._personKey"],
      "propertiesMapping": {
        "name": "$._fullName",
        "firstName": "$._firstName",
        "lastName": "$._lastName",
        "position": "$._roleDescription",
        "country": "$._country",
        "topics": "$._personTopics",
        "sourceUrl": "$._sourceUrl"
      },
      "propertyTypes": { "country": "country" }
    },
    {
      "ftmSchema": "Position",
      "idJsonPaths": ["$._positionKey"],
      "propertiesMapping": { "name": "$._positionName", "country": "$._country", "topics": "$._positionTopics" },
      "propertyTypes": { "country": "country" }
    },
    {
      "ftmSchema": "Occupancy",
      "idJsonPaths": ["$._occupancyKey"],
      "propertiesMapping": {
        "holder": "$._personKey",
        "post": "$._positionKey",
        "status": "$._status",
        "description": "$._roleDescription"
      },
      "propertyTypes": { "holder": "entity", "post": "entity" }
    }
  ]
}
