{
  "name": "lu_pep_international_orgs",
  "description": "Un titre « Prénom Nom, Fonction » par membre de la Cour AELE, suivi de sa biographie (« Born: 12 March 1965, in ... »)",
  "applyAllRules": true,
  "derivedFields": [
    { "name": "_name", "from": "heading", "regex": "^(.+?),\\s*(.+)$", "group": 1 },
    { "name": "_role", "from": "heading", "regex": "^(.+?),\\s*(.+)$", "group": 2 },
    { "name": "_firstName", "from": "_name", "regex": "^(.+?)\\s+(\\S+)$", "group": 1 },
    { "name": "_lastName", "from": "_name", "regex": "^(.+?)\\s+(\\S+)$", "group": 2 },
    { "name": "_birth", "from": "bio", "regex": "(?i)Born:\\s*(\\d{1,2}\\s+[A-Za-z]+\\s+\\d{4})" },
    { "name": "_birthPlace", "from": "bio", "regex": "(?i)Born:\\s*\\d{1,2}\\s+[A-Za-z]+\\s+\\d{4},\\s*in\\s*([^,.]+)" },
    { "name": "_citizenship", "from": "bio", "regex": "(?i)citizen of\\s+([^,.&]+)" },
    { "name": "_roleDescription", "template": "{_role}, Cour de justice de l'AELE", "requireAll": true },
    { "name": "_personSlug", "from": "_name", "slug": true },
    { "name": "_personKey", "template": "{_dataset}:{_personSlug}" },
    { "name": "_positionKey", "template": "{_dataset}:igo-leader" },
    { "name": "_positionName", "template": "Dirigeant d'une organisation internationale au Luxembourg" },
    { "name": "_organization", "template": "Cour de justice de l'AELE" },
    { "name": "_occupancyKey", "template": "{_personKey}:igo-leader" },
    { "name": "_country", "template": "lu" },
    { "name": "_personTopics", "template": "role.pep" },
    { "name": "_positionTopics", "template": "gov.igo", "split": ";" },
    { "name": "_status", "template": "current" }
  ],
  "recordFilters": [
    { "path": "_name", "operator": "NOT_EMPTY" }
  ],
  "rules": [
    {
      "ftmSchema": "Person",
      "idJsonPaths": ["$._personKey"],
      "propertiesMapping": {
        "name": "$._name",
        "firstName": "$._firstName",
        "lastName": "$._lastName",
        "birthDate": "$._birth",
        "birthPlace": "$._birthPlace",
        "nationality": "$._citizenship",
        "position": "$._roleDescription",
        "topics": "$._personTopics",
        "sourceUrl": "$._sourceUrl"
      },
      "propertyTypes": { "birthDate": "date", "nationality": "country" }
    },
    {
      "ftmSchema": "Position",
      "idJsonPaths": ["$._positionKey"],
      "propertiesMapping": {
        "name": "$._positionName",
        "country": "$._country",
        "summary": "$._organization",
        "topics": "$._positionTopics"
      },
      "propertyTypes": { "country": "country" }
    },
    {
      "ftmSchema": "Occupancy",
      "idJsonPaths": ["$._occupancyKey"],
      "propertiesMapping": {
        "holder": "$._personKey",
        "post": "$._positionKey",
        "status": "$._status",
        "description": "$._roleDescription"
      },
      "propertyTypes": { "holder": "entity", "post": "entity" }
    }
  ]
}
