{
  "name": "lu_pep_judiciary",
  "description": "« Monsieur Thierry HOSCHEIT, Président de la Cour constitutionnelle » : une personne par civilité citée",
  "applyAllRules": true,
  "explode": {
    "from": "line",
    "regex": "(Monsieur|Madame)\\s+([\\p{L}'’-]+(?:\\s+[\\p{L}'’-]+)*?)\\s*(?=,|\\set\\s|$)",
    "as": "_person"
  },
  "derivedFields": [
    { "name": "_title", "from": "_person_1" },
    { "name": "_name", "from": "_person_2" },
    { "name": "_lastName", "from": "_name", "regex": "((?:\\b\\p{Lu}[\\p{Lu}'’-]+\\b\\s*)+)$" },
    { "name": "_firstName", "from": "_name", "regex": "^(.*?)\\s+(?:\\p{Lu}[\\p{Lu}'’-]+\\b\\s*)+$" },
    { "name": "_personSlug", "from": "_name", "slug": true },
    { "name": "_personKey", "template": "{_dataset}:{_personSlug}" },
    { "name": "_vice", "from": "line", "regex": "(?i)(vice-pr[ée]sident)" },
    { "name": "_president", "from": "line", "regex": "(?i)^\\S+\\s+\\S+\\s+\\S+,\\s*(pr[ée]sident)" },
    { "name": "_roleRaw", "from": "_vice||_president" },
    { "name": "_role", "from": "_roleRaw", "regex": "(?i)^vice.*$", "replacement": "Vice-président de la Cour constitutionnelle" },
    { "name": "_roleDescription", "from": "_role", "regex": "(?i)^pr[ée]sident$", "replacement": "Président de la Cour constitutionnelle", "defaultValue": "Conseiller à la Cour constitutionnelle" },
    { "name": "_positionKey", "template": "{_dataset}:cour-constitutionnelle" },
    { "name": "_positionName", "template": "Membre de la Cour constitutionnelle" },
    { "name": "_occupancyKey", "template": "{_personKey}:cour-constitutionnelle" },
    { "name": "_country", "template": "lu" },
    { "name": "_personTopics", "template": "role.pep" },
    { "name": "_positionTopics", "template": "gov.national;gov.judicial", "split": ";" },
    { "name": "_status", "template": "current" }
  ],
  "recordFilters": [
    { "path": "_lastName", "operator": "NOT_EMPTY" }
  ],
  "rules": [
    {
      "ftmSchema": "Person",
      "idJsonPaths": ["$._personKey"],
      "propertiesMapping": {
        "name": "$._name",
        "firstName": "$._firstName",
        "lastName": "$._lastName",
        "gender": "$._title",
        "position": "$._roleDescription",
        "country": "$._country",
        "topics": "$._personTopics",
        "sourceUrl": "$._sourceUrl"
      },
      "propertyTypes": { "gender": "gender", "country": "country" }
    },
    {
      "ftmSchema": "Position",
      "idJsonPaths": ["$._positionKey"],
      "propertiesMapping": { "name": "$._positionName", "country": "$._country", "topics": "$._positionTopics" },
      "propertyTypes": { "country": "country" }
    },
    {
      "ftmSchema": "Occupancy",
      "idJsonPaths": ["$._occupancyKey"],
      "propertiesMapping": {
        "holder": "$._personKey",
        "post": "$._positionKey",
        "status": "$._status",
        "description": "$._roleDescription"
      },
      "propertyTypes": { "holder": "entity", "post": "entity" }
    }
  ]
}
