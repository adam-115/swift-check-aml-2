{
  "name": "lu_pep_municipal",
  "description": "Un mandat par ligne : la Person, la fonction de la commune (« Échevin de Beaufort ») et l'Occupancy",
  "applyAllRules": true,
  "derivedFields": [
    { "name": "_personKey", "template": "{_dataset}:{ELU_LAST_NAME}:{ELU_FIRST_NAME}:{COM_CODE}" },
    { "name": "_fullName", "template": "{ELU_FIRST_NAME} {ELU_LAST_NAME}" },
    { "name": "_function", "from": "MAN_LABEL", "slug": true },
    { "name": "_positionKey", "template": "{_dataset}:{_function}:{COM_CODE}" },
    { "name": "_positionName", "template": "{MAN_LABEL} de {COM_LABEL}" },
    { "name": "_occupancyKey", "template": "{_personKey}:{_function}:{COAC_START_DATE}" },
    { "name": "_status", "from": "COAC_END_DATE", "regex": ".+", "replacement": "ended", "defaultValue": "current" },
    { "name": "_country", "template": "lu" },
    { "name": "_personTopics", "template": "role.pep" },
    { "name": "_positionTopics", "template": "gov.muni" }
  ],
  "recordFilters": [
    { "path": "ELU_LAST_NAME", "operator": "NOT_EMPTY" },
    { "path": "COAC_END_DATE", "operator": "WITHIN_YEARS", "value": "5" }
  ],
  "rules": [
    {
      "ftmSchema": "Person",
      "idJsonPaths": ["$._personKey"],
      "propertiesMapping": {
        "name": "$._fullName",
        "firstName": "$.ELU_FIRST_NAME",
        "lastName": "$.ELU_LAST_NAME",
        "gender": "$.ELU_SEX",
        "country": "$._country",
        "topics": "$._personTopics",
        "sourceUrl": "$._sourceUrl"
      },
      "propertyTypes": { "gender": "gender", "country": "country" }
    },
    {
      "ftmSchema": "Position",
      "idJsonPaths": ["$._positionKey"],
      "propertiesMapping": {
        "name": "$._positionName",
        "country": "$._country",
        "subnationalArea": "$.COM_LABEL",
        "topics": "$._positionTopics"
      },
      "propertyTypes": { "country": "country" }
    },
    {
      "ftmSchema": "Occupancy",
      "idJsonPaths": ["$._occupancyKey"],
      "propertiesMapping": {
        "holder": "$._personKey",
        "post": "$._positionKey",
        "startDate": "$.COAC_START_DATE",
        "endDate": "$.COAC_END_DATE",
        "status": "$._status"
      },
      "propertyTypes": { "holder": "entity", "post": "entity", "startDate": "date", "endDate": "date" }
    }
  ]
}
