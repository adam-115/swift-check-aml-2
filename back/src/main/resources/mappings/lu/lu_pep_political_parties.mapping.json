{
  "name": "lu_pep_political_parties",
  "description": "Une ligne par dirigeant : parti, fonction, prénom, nom et page du parti",
  "applyAllRules": true,
  "derivedFields": [
    { "name": "_personSlug", "from": "nom_complet", "slug": true },
    { "name": "_partySlug", "from": "parti_code", "slug": true },
    { "name": "_personKey", "template": "{_dataset}:{_personSlug}" },
    { "name": "_roleDescription", "template": "{role} – {parti_nom} ({parti_code})" },
    { "name": "_positionKey", "template": "{_dataset}:party-leadership:{_partySlug}" },
    { "name": "_positionName", "template": "Membre de l'organe dirigeant du parti {parti_nom} ({parti_code})" },
    { "name": "_roleSlug", "from": "role", "slug": true },
    { "name": "_occupancyKey", "template": "{_personKey}:{_partySlug}:{_roleSlug}" },
    { "name": "_country", "template": "lu" },
    { "name": "_personTopics", "template": "role.pep" },
    { "name": "_positionTopics", "template": "pol.party", "split": ";" },
    { "name": "_status", "template": "current" }
  ],
  "recordFilters": [
    { "path": "nom_complet", "operator": "NOT_EMPTY" }
  ],
  "rules": [
    {
      "ftmSchema": "Person",
      "idJsonPaths": ["$._personKey"],
      "propertiesMapping": {
        "name": "$.nom_complet",
        "firstName": "$.prenom",
        "lastName": "$.nom",
        "political": "$.parti_code",
        "position": "$._roleDescription",
        "country": "$._country",
        "topics": "$._personTopics",
        "sourceUrl": "$.source_url"
      },
      "propertyTypes": { "country": "country" }
    },
    {
      "ftmSchema": "Position",
      "idJsonPaths": ["$._positionKey"],
      "propertiesMapping": { "name": "$._positionName", "country": "$._country", "topics": "$._positionTopics" },
      "propertyTypes": { "country": "country" }
    },
    {
      "ftmSchema": "Occupancy",
      "idJsonPaths": ["$._occupancyKey"],
      "propertiesMapping": {
        "holder": "$._personKey",
        "post": "$._positionKey",
        "status": "$._status",
        "description": "$._roleDescription"
      },
      "propertyTypes": { "holder": "entity", "post": "entity" }
    }
  ]
}
