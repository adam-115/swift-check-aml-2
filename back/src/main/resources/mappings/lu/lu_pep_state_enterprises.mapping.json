{
  "name": "lu_pep_state_enterprises",
  "description": "Une entreprise par élément de « entites » ; une personne par membre du conseil ou de la direction (« NOM Prénom »)",
  "applyAllRules": true,
  "explode": {
    "paths": ["$.membresConseil[*]", "$.membresDirection[*]"],
    "as": "_member"
  },
  "derivedFields": [
    { "name": "_rawName", "from": "$._member.nom" },
    { "name": "_lastName", "from": "_rawName", "regex": "^((?:\\p{Lu}[\\p{Lu}'’-]+\\s*)+)\\s" },
    { "name": "_firstName", "from": "_rawName", "regex": "^(?:\\p{Lu}[\\p{Lu}'’-]+\\s*)+\\s(.+)$" },
    { "name": "_displayName", "template": "{_firstName} {_lastName}", "requireAll": true },
    { "name": "_name", "from": "_displayName||_rawName" },
    { "name": "_title", "from": "$._member.titre" },
    { "name": "_body", "from": "_member_path", "regex": "membresConseil", "replacement": "Conseil" },
    { "name": "_bodyLabel", "from": "_body", "regex": "^\\$\\.membresDirection.*$", "replacement": "Direction" },
    { "name": "_memberRole", "from": "$._member.role" },
    { "name": "_defaultRole", "from": "_bodyLabel", "regex": "^Conseil.*$", "replacement": "Administrateur" },
    { "name": "_defaultRoleFinal", "from": "_defaultRole", "regex": "^Direction$", "replacement": "Membre de la direction" },
    { "name": "_role", "from": "_memberRole||_defaultRoleFinal" },
    { "name": "_roleDescription", "template": "{_role} – {nom}" },
    { "name": "_companySlug", "from": "nom", "slug": true },
    { "name": "_roleSlug", "from": "_role", "slug": true },
    { "name": "_personSlug", "from": "_name", "slug": true },
    { "name": "_personKey", "template": "{_dataset}:{_personSlug}" },
    { "name": "_positionKey", "template": "{_dataset}:state-enterprise-leader" },
    { "name": "_positionName", "template": "Administrateur, directeur ou commissaire du gouvernement d'une entreprise publique" },
    { "name": "_occupancyKey", "template": "{_personKey}:{_companySlug}:{_roleSlug}" },
    { "name": "_country", "template": "lu" },
    { "name": "_personTopics", "template": "role.pep" },
    { "name": "_positionTopics", "template": "gov.soe", "split": ";" },
    { "name": "_status", "template": "current" }
  ],
  "recordFilters": [
    { "path": "_rawName", "operator": "NOT_EMPTY" }
  ],
  "rules": [
    {
      "ftmSchema": "Person",
      "idJsonPaths": ["$._personKey"],
      "propertiesMapping": {
        "name": "$._name",
        "firstName": "$._firstName",
        "lastName": "$._lastName",
        "gender": "$._title",
        "position": "$._roleDescription",
        "country": "$._country",
        "topics": "$._personTopics",
        "sourceUrl": "$._sourceUrl"
      },
      "propertyTypes": { "gender": "gender", "country": "country" }
    },
    {
      "ftmSchema": "Position",
      "idJsonPaths": ["$._positionKey"],
      "propertiesMapping": { "name": "$._positionName", "country": "$._country", "topics": "$._positionTopics" },
      "propertyTypes": { "country": "country" }
    },
    {
      "ftmSchema": "Occupancy",
      "idJsonPaths": ["$._occupancyKey"],
      "propertiesMapping": {
        "holder": "$._personKey",
        "post": "$._positionKey",
        "status": "$._status",
        "description": "$._roleDescription"
      },
      "propertyTypes": { "holder": "entity", "post": "entity" }
    }
  ]
}
